<div class="flex flex-col">
  <%= render Money::FormComponent.new(date: selected_date) %>
  <%= render Money::ButtonsComponent.new %>
  <div class="flex flex-col xl:flex-row mx-8 justify-between">
    <div class="flex xl:w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.overall_balance"), balance: overall_balance) %>
    </div>
    <div class="flex xl:w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.monthly_balance"), balance: monthly_balance) %>
    </div>
    <div class="flex xl:w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.yearly_balance"), balance: yearly_balance) %>
    </div>
  </div>
  <%= render Money::Incomes::ShowComponent.new(incomes: incomes, date: @selected_date) %>
  <%= render Money::Spendings::ShowComponent.new(spendings: spendings, date: @selected_date) %>
  <%= render Money::Currencies::RatesComponent.new(rates: rates, home_site: true) %>
  <%= render Money::Goals::ShowComponent.new(goals: goals) %>
</div>
