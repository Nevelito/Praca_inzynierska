<div class="flex flex-col">
  <%= render Money::FormComponent.new(date: selected_date) %>
  <%= render Money::ButtonsComponent.new %>
  <div class="flex flex-row mx-8 justify-between">
    <div class="flex w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.overall_balance"), balance: overall_balance) %>
    </div>
    <div class="flex w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.monthly_balance"), balance: monthly_balance) %>
    </div>
    <div class="flex w-1/3">
      <%= render Money::BalanceComponent.new(text: I18n.t("money.yearly_balance"), balance: yearly_balance) %>
    </div>
  </div>
  <%= render Money::Incomes::ShowComponent.new(incomes: incomes) %>
  <%= render Money::Spendings::ShowComponent.new(spendings: spendings) %>
  <%= render Money::Charts::ColumnComponent.new(data: spendings_by_day, date: selected_date, type: "daily") %>
  <%= render Money::Charts::ColumnComponent.new(data: spendings_by_month, date: selected_date, type: "monthly") %>
  <%= render Money::RatesComponent.new(rates: rates) %>
  <%= render Money::Goals::ShowComponent.new(goals: goals) %>
</div>
