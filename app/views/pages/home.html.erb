<div class="flex flex-col items-center bg-gray-50 min-h-screen py-12 space-y-16">
  <div class="w-full max-w-6xl bg-gradient-to-r from-blue-600 to-blue-400 shadow-2xl rounded-xl p-10 mb-12 text-center text-white">
    <h1 class="text-5xl font-extrabold tracking-tight mb-6">
      <%= I18n.t("pages.home.name") %>
    </h1>
    <p class="text-2xl font-light mb-8">
      <%= I18n.t("pages.home.welcome_in").html_safe %>
    </p>
    <%= link_to "Zacznij Teraz", money_index_path, class: "inline-block bg-white text-blue-700 font-semibold py-4 px-8 rounded-full shadow-md hover:bg-gray-100 transition-transform transform hover:-translate-y-1 duration-300" %>
  </div>

  <div class="w-full max-w-6xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
    <div class="relative group bg-white shadow-lg rounded-xl p-8 flex flex-col items-center text-center transition-shadow hover:shadow-2xl">
      <h2 class="text-3xl font-bold text-blue-700 mb-4"><%= I18n.t("pages.home.heading_save_money") %></h2>
      <%= image_tag "save_money.jpeg", class: "w-full h-64 object-cover rounded-lg mb-6 transition-transform duration-300 ease-in-out group-hover:scale-105" %>
      <p class="text-gray-600 text-lg mb-4">
        <%= I18n.t("pages.home.save_money") %>
      </p>
      <div class="absolute inset-0 bg-blue-100 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
    </div>
    <div class="relative group bg-white shadow-lg rounded-xl p-8 flex flex-col items-center text-center transition-shadow hover:shadow-2xl">
      <h2 class="text-3xl font-bold text-blue-700 mb-4"><%= I18n.t("pages.home.heading_goals") %></h2>
      <%= image_tag "cel_finansowy.jpg", class: "w-full h-64 object-cover rounded-lg mb-6 transition-transform duration-300 ease-in-out group-hover:scale-105" %>
      <p class="text-gray-600 text-lg mb-4">
        <%= I18n.t("pages.home.goals") %>
      </p>
      <div class="absolute inset-0 bg-blue-100 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
    </div>
    <div class="relative group bg-white shadow-lg rounded-xl p-8 flex flex-col items-center text-center transition-shadow hover:shadow-2xl">
      <h2 class="text-3xl font-bold text-blue-700 mb-4"><%= I18n.t("pages.home.heading_currency") %></h2>
      <%= image_tag "wymiana_waluty.jpg", class: "w-full h-64 object-cover rounded-lg mb-6 transition-transform duration-300 ease-in-out group-hover:scale-105" %>
      <p class="text-gray-600 text-lg mb-4">
        <%= I18n.t("pages.home.currency") %>
      </p>
      <div class="absolute inset-0 bg-blue-100 opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
    </div>
  </div>

  <div class="w-full max-w-6xl bg-gradient-to-r from-blue-700 to-blue-500 shadow-xl rounded-xl p-10 mt-12 text-center text-white">
    <h3 class="text-4xl font-extrabold mb-6"><%= I18n.t("pages.home.ready_to_save") %></h3>
    <p class="text-xl mb-8"><%= I18n.t("pages.home.join_us") %></p>
    <%= link_to I18n.t("pages.home.go_to_money"), money_index_path, class: "bg-white text-blue-700 font-semibold py-4 px-10 rounded-full shadow-lg hover:bg-gray-100 transition-transform transform hover:-translate-y-1 duration-300" %>
  </div>
</div>
