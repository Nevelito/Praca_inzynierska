<%= turbo_frame_tag 'modal' do %>
  <div data-controller="modal">
    <div data-modal-target="modal">
      <div class="flex flex-col fixed box-border top-0 bottom-0 w-full bg-white z-50 overflow-y-auto xl:right-0 xl:pb-0 xl:w-[44rem] xl:border-l xl:border-neutral-200 xl:shadow-md">
        <%= render Modal::HeadingComponent.new(text: I18n.t("goals.new_goal")) %>
        <div class="px-7 xl:px-12 mt-6">
          <%= form_for(goal, data: { turbo_frame: "_top" }, html: { class: "w-full" }) do |f| %>
            <div class="flex flex-col gap-3">
              <%= f.label :name, I18n.t("goals.name") %>
              <%= f.text_field :name, maxlength: 100, placeholder: t("goals.add_name"), class: "w-full placeholder-neutral-800 border border-neutral-300 h-13 py-[0.88rem] px-4 mr-5 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :target_amount, I18n.t("goals.target_amount") %>
              <%= f.number_field :target_amount, maxlength: 100, placeholder: t("goals.add_target_amount"), class: "w-full placeholder-neutral-800 border border-neutral-300 h-13 py-[0.88rem] px-4 mr-5 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :currency, I18n.t("incomes.new.currency") %>
              <%= f.select :currency, options_for_select(
                [
                  ['PLN', 'PLN'], ['USD', 'USD'], ['EUR', 'EUR'],
                  ['GBP', 'GBP'], ['CHF', 'CHF'], ['AUD', 'AUD'],
                  ['CAD', 'CAD'], ['CZK', 'CZK'], ['DKK', 'DKK'],
                  ['JPY', 'JPY'], ['NOK', 'NOK'], ['SEK', 'SEK'],
                  ['HUF', 'HUF'], ['RUB', 'RUB'], ['CNY', 'CNY']
                ], selected: 'PLN',
                ), {}, class: "border border-neutral-300 overflow-auto py-[0.88rem] px-4 w-full placeholder-neutral-800 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :due_date, I18n.t("goals.due_date") %>
              <%= f.date_field :due_date, class: "w-full placeholder-neutral-800 border border-neutral-300 py-[0.88rem] px-4 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :description, I18n.t("goals.description") %>
              <%= f.text_area :description, maxlength: 300, placeholder: t("goals.add_description"), class: "w-full placeholder-neutral-800 border border-neutral-300 py-[0.88rem] px-4 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex w-full justify-end">
              <%= button_tag I18n.t("goals.cancel"), data: { action: "modal#hideModal" }, type: "button", class: "bg-red-700 text-white w-24 h-12 mr-4 xl:mr-5 rounded-lg" %>
              <%= f.submit I18n.t("goals.save"), class: "bg-green-700 h-12 px-8 text-white rounded-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
