<div>
  <div class="flex px-4 xl:px-12">
    <%= link_to "javascript:history.back()", class: "flex mt-0 xl:mt-4 pl-2 mb-4" do %>
      <%= inline_svg_tag "arrow_left.svg", class: "w-6 h-6" %>
      <p class="text-green-900 font-medium ml-3"><%= I18n.t('goals.back') %></p>
    <% end %>
  </div>
  <div class="flex flex-col mx-6 xl:mx-12 bg-neutral-200 rounded-lg py-8 mb-10">
    <%= render Goals::HeadingComponent.new(goal: goal, goal_payments: goal_payments) %>

    <div class="flex flex-col px-4 xl:px-12">
      <%= render Goals::PaymentComponent.with_collection(goal_payments) %>
    </div>
  </div>
</div>
