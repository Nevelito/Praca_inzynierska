<div class="flex flex-col">
  <div class="px-4 xl:px-12 mb-6">
    <%= link_to money_index_path, class: "flex mt-0 xl:mt-4 pl-2 mb-4" do %>
      <%= inline_svg_tag "arrow_left.svg", class: "w-6 h-6" %>
      <p class="text-green-900 font-medium ml-3"><%= I18n.t('goals.back') %></p>
    <% end %>
  </div>
  <%= render Incomes::FormComponent.new(date: selected_date) %>
  <%= render Incomes::History::ShowComponent.new(incomes: incomes) %>
  <%= render Money::Charts::ColumnComponent.new(data: incomes_by_day, date: selected_date, type: "daily_incomes") %>
  <%= render Money::Charts::ColumnComponent.new(data: incomes_by_month, date: selected_date, type: "monthly_incomes") %>
</div>
