<%= turbo_frame_tag 'modal' do %>
  <div data-controller="modal">
    <div data-modal-target="modal">
      <div class="flex flex-col fixed box-border top-0 bottom-0 w-full bg-white z-50 overflow-y-auto xl:right-0 xl:pb-0 xl:w-[44rem] xl:border-l xl:border-neutral-200 xl:shadow-md">
        <%= render Modal::HeadingComponent.new(text: I18n.t("incomes.edit.edit_income")) %>
        <div class="px-7 xl:px-12 mt-6">
          <%= form_for(income, data: { turbo_frame: "_top" }, html: { class: "w-full" }) do |f| %>
            <div class="flex flex-col gap-3">
              <%= f.label :amount, I18n.t("incomes.edit.amount") %>
              <%= f.number_field :amount, step: "any", maxlength: 100, placeholder: t("incomes.edit.edit_amount"), class: "w-full placeholder-neutral-800 border border-neutral-300 h-13 py-[0.88rem] px-4 mr-5 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :date, I18n.t("incomes.edit.date") %>
              <%= f.date_field :date, class: "w-full placeholder-neutral-800 border border-neutral-300 py-[0.88rem] px-4 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex flex-col mt-5 mb-7 gap-3 xl:mb-10">
              <%= f.label :description, I18n.t("incomes.edit.description") %>
              <%= f.text_field :description, maxlength: 100, placeholder: t("incomes.edit.edit_description"), class: "w-full placeholder-neutral-800 border border-neutral-300 h-13 py-[0.88rem] px-4 mr-5 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex w-full justify-end">
              <%= button_tag I18n.t("incomes.edit.cancel"), data: { action: "modal#hideModal" }, type: "button", class: "bg-red-700 text-white w-24 h-12 mr-4 xl:mr-5 rounded-lg" %>
              <%= f.submit I18n.t("incomes.edit.save"), class: "bg-green-700 h-12 px-8 text-white rounded-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
