<%= turbo_frame_tag 'modal' do %>
  <div data-controller="modal">
    <div data-modal-target="modal" class="fixed inset-0 flex items-center justify-center z-50">
      <div class="box-border h-80 w-full max-w-xl bg-white overflow-y-auto xl:w-[44rem] xl:border-l xl:border-neutral-200 xl:shadow-md">
        <%= render Modal::HeadingComponent.new(text: "#{I18n.t('goal_payments.edit_money_to_goal')} #{goal.name}") %>
        <div class="px-7 xl:px-12 mt-6">
          <%= form_for(goal_payment, data: { turbo_frame: "_top" }, html: { class: "w-full" }) do |f| %>
            <%= f.hidden_field :goal_id, value: goal.id %>
            <div class="flex flex-col gap-3">
              <%= f.label :amount, t('goal_payments.amount') %>
              <%= f.number_field :amount, step: "any", maxlength: 100, placeholder: t('goal_payments.edit_money'), class: "w-full placeholder-neutral-800 border border-neutral-300 h-13 py-[0.88rem] px-4 mr-5 focus:outline-none rounded-lg" %>
            </div>
            <div class="flex w-full justify-end mt-12">
              <%= button_tag t('goal_payments.cancel'), data: { action: "modal#hideModal" }, class: "bg-red-700 text-white w-24 h-12 mr-4 xl:mr-5 rounded-lg" %>
              <%= f.submit t('goal_payments.save'), class: "bg-green-700 h-12 px-8 text-white rounded-lg" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
