<div class="flex flex-col mx-6 xl:mx-12 bg-neutral-200 rounded-lg pb-8 mb-10">
  <div class="px-4 xl:px-8 py-6 flex flex-col xl:flex-row justify-between space-y-4 xl:space-y-0 bg-gradient-to-r from-blue-500 to-blue-300 text-white mb-6">
    <div class="text-sm xl:text-lg font-semibold"><%= "#{I18n.t("money.rates.rates_on_day")} #{date}" %></div>
    <% if home_site %>
      <div>
        <%= link_to I18n.t("currencies.go_to_calculator"),
                    currency_index_path,
                    class: "bg-blue-700 text-white border border-blue-700 py-2 px-4 text-sm xl:text-base rounded-full shadow-md hover:bg-blue-800 transition duration-300" %>
      </div>
  <% end %>
  </div>
  <div class="overflow-x-auto mx-4 xl:mx-8">
    <table class="min-w-full bg-white border-collapse">
      <thead class="bg-neutral-100">
      <tr>
        <th class="py-3 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= "#{I18n.t("money.rates.currency")}" %></th>
        <th class="py-3 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= "#{I18n.t("money.rates.rate")}" %></th>
      </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
      <% rates.each do |rate| %>
        <tr>
          <td class="py-4 px-6 whitespace-nowrap text-sm font-medium text-gray-900"><%= rate['code'] %></td>
          <td class="py-4 px-6 whitespace-nowrap text-sm text-gray-500"><%= "#{rate['mid']} PLN" %></td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>
