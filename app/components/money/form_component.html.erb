<div class="flex flex-row space-x-4 items-center justify-center mb-6">
  <%= form_with url: money_index_path, method: :get, local: true, class: "flex flex-row items-center space-x-4" do |f| %>
    <div class="flex flex-row items-center">
      <%= f.label :month, I18n.t("money.month"), class: "block text-gray-700 text-sm font-bold mr-2" %>
      <%= f.select :month, (1..12).map { |m| [I18n.t("date.month_names")[m], m] }, { selected: date.strftime("%m").to_i || Date.today.month }, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>

    <div class="flex flex-row items-center">
      <%= f.label :year, I18n.t("money.year"), class: "block text-gray-700 text-sm font-bold mr-2" %>
      <%= f.number_field :year, value: date.strftime("%Y").to_i || Date.today.year, class: "shadow appearance-none border rounded py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>

    <div>
      <%= f.submit I18n.t("money.filter"), class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" %>
    </div>
  <% end %>
</div>
