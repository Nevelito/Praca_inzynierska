<div class="flex flex-col bg-white shadow-lg rounded-xl p-8 mb-6 mx-4 xl:mx-12">
  <div class="flex flex-row justify-between items-center mb-4">
    <div class="text-2xl font-extrabold text-blue-700">
      <%= goal.name %>
    </div>
    <div class="text-lg font-semibold text-gray-600">
      <%= "#{I18n.t("goals.due_date_2")} #{goal.due_date.strftime("%d.%m.%Y")}" %>
    </div>
  </div>

  <div class="mb-6">
    <div class="text-lg text-gray-700 mb-2">
      <%= I18n.t("goals.description_2") %>
    </div>
    <div class="text-lg font-semibold text-gray-900">
      <%= goal.description %>
    </div>
  </div>

  <div class="mb-6">
    <div class="text-lg text-gray-700 mb-2 text-center">
      <%= I18n.t("goals.earn_money") %>
    </div>
    <div class="text-lg font-semibold text-blue-700 text-center">
      <%= I18n.t("goals.balance", sum: saved_money, goal: goal.target_amount) %>
    </div>
  </div>

  <div class="flex justify-center mb-6">
    <%= link_to I18n.t("goals.add_money_to_goal"),
                new_goal_payment_path(goal: goal),
                data: { turbo_frame: "modal" },
                class: "bg-blue-600 text-white font-semibold py-2 px-4 rounded-full shadow-md hover:bg-blue-700 transition-colors duration-300" %>
  </div>
</div>

<div class="flex flex-col bg-white shadow-lg rounded-xl p-8 pb-0 mx-4 xl:mx-12 xl:mb-2">
  <div class="text-xl font-bold"><%= I18n.t("goal_payments.payments") %></div>
  <div class="flex flex-col border-t-2 border-gray-200 mt-6">
    <div class="flex items-center justify-between py-2 px-4 font-bold text-gray-800">
      <div class="w-1/2 xl:w-1/3">
        <%= I18n.t("goal_payments.amount") %>
      </div>
      <div class="hidden xl:flex w-1/3 justify-center">
        <%= I18n.t("goal_payments.payment_date") %>
      </div>
      <div class="w-1/2 xl:w-1/3 text-right">
        <%= I18n.t("goal_payments.options") %>
      </div>
    </div>
  </div>
</div>
