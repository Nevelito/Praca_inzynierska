<div class="flex flex-row items-center justify-between bg-white border border-gray-300 shadow-md rounded-lg my-2 px-4 xl:px-12 py-3">
  <div class="text-lg font-semibold text-blue-700 w-1/2 xl:w-1/3">
    <%= "#{goal_payment.amount} PLN" %>
  </div>
  <div class="hidden xl:flex text-lg text-gray-600 w-1/3 justify-center">
    <%= "#{date.strftime("%d")} #{I18n.t("date.month_names")[date.strftime("%m").to_i]} #{date.strftime("%Y")}" %>
  </div>
  <div class="w-1/2 xl:w-1/3 flex justify-end">
    <%= render Goals::OptionButtonsComponent.new(goal_payment: goal_payment) %>
  </div>
</div>
