<div class="flex flex-row space-x-4 place-items-center">
  <%= link_to edit_spending_path(spending), remote: true, data: { turbo_frame: 'modal' } do %>
    <%= inline_svg_tag "pen.svg", class: "w-4 h-4" %>
  <% end %>
  <%= link_to spending_path(spending), data: {
    turbo_method: :delete,
    turbo_frame: "_top",
    turbo_confirm: t("spendings.delete_spending")
  } do %>
    <%= inline_svg_tag "trash_can.svg", class: "w-4 h-4" %>
  <% end %>
</div>
