<div class="flex flex-row space-x-4 items-center justify-center mb-8">
  <%= form_with url: spendings_path, method: :get, local: true, class: "flex flex-col xl:flex-row xl:items-center space-y-6 xl:space-y-0 xl:space-x-6 bg-white shadow-md rounded-lg p-6" do |f| %>
    <div class="flex flex-col xl:flex-row items-center xl:items-center space-y-2 xl:space-y-0 xl:space-x-4">
      <%= f.label :month, I18n.t("spendings.month"), class: "block text-gray-700 text-sm font-bold mr-2" %>
      <%= f.select :month, (1..12).map { |m| [I18n.t("date.month_names")[m], m] }, { selected: date.strftime("%m").to_i || Date.today.month }, class: "shadow appearance-none border rounded py-1 px-2 xl:py-2 xl:px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    <div class="flex flex-col xl:flex-row items-center xl:items-center space-y-2 xl:space-y-0 xl:space-x-4">
      <%= f.label :year, I18n.t("spendings.year"), class: "block text-gray-700 text-sm font-bold mr-2" %>
      <%= f.number_field :year, value: date.strftime("%Y").to_i || Date.today.year, class: "shadow appearance-none border rounded py-1 px-2 xl:py-2 xl:px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    <div class="flex flex-col xl:flex-row items-center xl:items-center space-y-2 xl:space-y-0 xl:space-x-4">
      <%= f.label :kind, I18n.t("spendings.kind"), class: "block text-gray-700 text-sm font-bold mr-2" %>
      <%= f.select :kind, options_for_select([["Dom", "house"], ["Samochód", "car"], ["Zdrowie", "healthcare"], ["Rozrywka", "entertainment"], ["Artykuły spożywcze", "groceries"], ["Restauracja", "restaurant"], ["Zakupy", "shopping"], ["Inne", "other"], ["Wszystkie", "all"]], kind), {}, class: "shadow appearance-none border rounded py-1 px-2 xl:py-2 xl:px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline" %>
    </div>
    <div class="flex justify-center">
      <%= f.submit I18n.t("spendings.filter"), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-200" %>
    </div>
  <% end %>
</div>
